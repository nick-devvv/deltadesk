# ~/.config/deltadesk/deltadesk.env  (chmod 600, owner box, NEVER committed)
# Copy the values the desk already uses from Chart's Secrets. Never put Nick's account passwords here.
PORT=8765
# DESK_TOKEN=<long random string; generate on the box: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'>
# SCHWAB_APP_KEY=...
# SCHWAB_APP_SECRET=...
# SEC_USER_AGENT=DeltaDesk research <contact>
# Phone alerts (optional). ntfy: install the ntfy app, subscribe to a long random topic name, put it here.
# NTFY_TOPIC=<long-random-topic>
# Telegram: create a bot with @BotFather, send it any message, read your chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates  (message.chat.id), then:
# TELEGRAM_BOT_TOKEN=<from BotFather>
# TELEGRAM_CHAT_ID=<your chat id>
